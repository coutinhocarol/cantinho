{
  "name": "cantinho-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run setup:dev && node --env-file=.dev.vars node_modules/wrangler/bin/wrangler.js dev",
    "deploy": "npm --prefix ../frontend run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node --env-file=../.env --experimental-strip-types scripts/migrate.ts",
    "setup:dev": "node --env-file=../.env --experimental-strip-types scripts/dev-vars.ts"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.2"
  }
}